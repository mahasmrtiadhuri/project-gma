{
  "name": "project-gma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generative Micro-Climate Architect — geospatial micro-climate simulation and routing engine for NYC. Glass-glare ray tracing, Venturi wind-canyon approximation, conversational routing via Gemini.",
  "author": "Maha Smrti Adhuri <mahasmrtiadhuri@gmail.com>",
  "license": "MIT",
  "keywords": [
    "deck.gl",
    "google-maps-platform",
    "photorealistic-3d-tiles",
    "webgl",
    "gemini",
    "geospatial",
    "routing",
    "micro-climate",
    "ray-tracing"
  ],
  "homepage": "https://github.com/mahasmrtiadhuri/project-gma",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n vite,solar -c blue,yellow \"npm:dev\" \"npm:start:server\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "start:server": "node server/index.js"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.38",
    "@deck.gl/geo-layers": "^9.0.38",
    "@deck.gl/layers": "^9.0.38",
    "@deck.gl/react": "^9.0.38",
    "@loaders.gl/3d-tiles": "^4.3.3",
    "@loaders.gl/core": "^4.3.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/google.maps": "^3.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-glsl": "^1.3.1",
    "vite-plugin-pwa": "^0.21.1"
  }
}
